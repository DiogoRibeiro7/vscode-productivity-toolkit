{
  "taskVersion": "1.0.0",
  "category": "backup-maintenance",
  "displayName": "Backup and Maintenance",
  "description": "System backup, cleanup, and maintenance tasks for project health and data protection",
  "tasks": [
    {
      "label": "Backup: Create Project Archive",
      "type": "shell",
      "command": "tar",
      "args": ["-czf", "../${workspaceFolderBasename}_backup_$(date +%Y%m%d_%H%M%S).tar.gz", "--exclude=node_modules", "--exclude=.git", "--exclude=build", "--exclude=dist", "."],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Backup: Git Repository Mirror",
      "type": "shell",
      "command": "git",
      "args": ["clone", "--mirror", ".", "../${workspaceFolderBasename}_mirror_$(date +%Y%m%d_%H%M%S).git"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Backup: Database Export",
      "type": "shell",
      "command": "pg_dump",
      "args": ["-h", "${input:dbHost}", "-U", "${input:dbUser}", "-d", "${input:dbName}", "-f", "backup_db_$(date +%Y%m%d_%H%M%S).sql"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Cleanup: Remove Node Modules",
      "type": "shell",
      "command": "find",
      "args": [".", "-name", "node_modules", "-type", "d", "-exec", "rm", "-rf", "{}", "+"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Cleanup: Remove Build Artifacts",
      "type": "shell",
      "command": "rm",
      "args": ["-rf", "build", "dist", "*.tgz", "coverage"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Cleanup: Remove Log Files",
      "type": "shell",
      "command": "find",
      "args": [".", "-name", "*.log", "-type", "f", "-delete"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Cleanup: Docker System Prune",
      "type": "shell",
      "command": "docker",
      "args": ["system", "prune", "-a", "-f"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Maintenance: Update Dependencies",
      "type": "shell",
      "command": "npm",
      "args": ["update"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Maintenance: Check for Outdated Packages",
      "type": "shell",
      "command": "npm",
      "args": ["outdated"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Maintenance: Rebuild Package Lock",
      "type": "shell",
      "command": "sh",
      "args": ["-c", "rm package-lock.json && npm install"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Maintenance: Git Garbage Collection",
      "type": "shell",
      "command": "git",
      "args": ["gc", "--aggressive", "--prune=now"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Maintenance: Verify Repository Integrity",
      "type": "shell",
      "command": "git",
      "args": ["fsck", "--full"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Archive: Create Release Bundle",
      "type": "shell",
      "command": "sh",
      "args": ["-c", "npm run build && tar -czf ${workspaceFolderBasename}_v${input:version}.tar.gz build/"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Archive: Generate Project Manifest",
      "type": "shell",
      "command": "sh",
      "args": ["-c", "find . -type f -not -path './.git/*' -not -path './node_modules/*' | sort > project_manifest_$(date +%Y%m%d).txt"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
