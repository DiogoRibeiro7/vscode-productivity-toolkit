{
  "name": "smart-task-detector",
  "displayName": "Smart Task Detector",
  "description": "Automatically detects project types and suggests relevant VS Code tasks for enhanced productivity",
  "version": "1.0.0",
  "publisher": "diogoribeiro7",
  "author": {
    "name": "Diogo Ribeiro",
    "email": "dfr@esmad.ipp.pt",
    "url": "https://orcid.org/0009-0001-2022-7072"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiogoRibeiro7/vscode-productivity-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/DiogoRibeiro7/vscode-productivity-toolkit/issues"
  },
  "homepage": "https://github.com/DiogoRibeiro7/vscode-productivity-toolkit#readme",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Testing",
    "Debuggers"
  ],
  "keywords": [
    "productivity",
    "automation",
    "tasks",
    "workflow",
    "development",
    "python",
    "javascript",
    "react",
    "docker",
    "git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smartTaskDetector.detectAndInstall",
        "title": "Detect and Install Tasks",
        "category": "Smart Task Detector"
      },
      {
        "command": "smartTaskDetector.openTaskManager",
        "title": "Open Task Manager",
        "category": "Smart Task Detector"
      },
      {
        "command": "smartTaskDetector.refreshTasks",
        "title": "Refresh Tasks",
        "category": "Smart Task Detector",
        "icon": "$(refresh)"
      },
      {
        "command": "smartTaskDetector.installTask",
        "title": "Install Task",
        "category": "Smart Task Detector",
        "icon": "$(add)"
      },
      {
        "command": "smartTaskDetector.removeTask",
        "title": "Remove Task",
        "category": "Smart Task Detector",
        "icon": "$(trash)"
      },
      {
        "command": "smartTaskDetector.showWelcome",
        "title": "Show Welcome",
        "category": "Smart Task Detector"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "smartTaskDetector.tasks",
          "name": "Productivity Tasks",
          "when": "workbenchState != empty"
        },
        {
          "id": "smartTaskDetector.projects",
          "name": "Detected Projects",
          "when": "workbenchState != empty"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "smartTaskDetector.tasks",
        "contents": "No tasks installed yet.\n[Detect and Install Tasks](command:smartTaskDetector.detectAndInstall)\n[Open Task Manager](command:smartTaskDetector.openTaskManager)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "smartTaskDetector.refreshTasks",
          "when": "view == smartTaskDetector.tasks",
          "group": "navigation"
        },
        {
          "command": "smartTaskDetector.openTaskManager",
          "when": "view == smartTaskDetector.tasks",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "smartTaskDetector.installTask",
          "when": "view == smartTaskDetector.tasks && viewItem == availableTask",
          "group": "inline"
        },
        {
          "command": "smartTaskDetector.removeTask",
          "when": "view == smartTaskDetector.tasks && viewItem == installedTask",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "smartTaskDetector.detectAndInstall",
          "when": "workbenchState != empty"
        },
        {
          "command": "smartTaskDetector.openTaskManager",
          "when": "workbenchState != empty"
        },
        {
          "command": "smartTaskDetector.refreshTasks",
          "when": "false"
        },
        {
          "command": "smartTaskDetector.installTask",
          "when": "false"
        },
        {
          "command": "smartTaskDetector.removeTask",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Smart Task Detector",
      "properties": {
        "smartTaskDetector.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect project types and suggest tasks on workspace open"
        },
        "smartTaskDetector.showWelcomeOnFirstRun": {
          "type": "boolean",
          "default": true,
          "description": "Show welcome screen on first run"
        },
        "smartTaskDetector.taskRepositoryUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/DiogoRibeiro7/vscode-productivity-toolkit/main/tasks",
          "description": "URL to the task repository"
        },
        "smartTaskDetector.enableNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Enable notifications for task suggestions and installations"
        },
        "smartTaskDetector.preferredCategories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Preferred task categories to prioritize in suggestions"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.4",
    "ts-loader": "^9.4.1",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0",
    "@vscode/test-electron": "^2.2.0"
  },
  "dependencies": {
    "axios": "^1.2.0",
    "fs-extra": "^11.3.2"
  }
}
