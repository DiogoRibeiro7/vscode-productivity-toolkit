{
  "_fileLocation": "/tasks/javascript/",
  "_metadata": {
    "license": "MIT License - Copyright (c) 2025 Diogo Ribeiro",
    "maintainer": "Diogo Ribeiro <dfr@esmad.ipp.pt>",
    "description": "VS Code tasks for JavaScript/TypeScript development: linting, formatting, testing, and dependency management.",
    "version": "1.0.0"
  },
  "version": "2.0.0",
  "inputs": [
    {
      "id": "packageManager",
      "type": "pickString",
      "description": "Package manager to use",
      "options": ["npm", "yarn", "pnpm"],
      "default": "npm"
    },
    {
      "id": "testDirectory",
      "type": "promptString",
      "description": "Test directory or pattern",
      "default": "test"
    },
    {
      "id": "srcDirectory",
      "type": "promptString",
      "description": "Source directory",
      "default": "src"
    },
    {
      "id": "buildDirectory",
      "type": "promptString",
      "description": "Build output directory",
      "default": "dist"
    }
  ],
  "tasks": [
    {
      "label": "javascript:install",
      "detail": "Install dependencies",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["install"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$npm-install"
      ]
    },
    {
      "label": "javascript:lint-eslint",
      "detail": "Lint JavaScript/TypeScript with ESLint",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["run", "lint"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$eslint-stylish"
      ]
    },
    {
      "label": "javascript:lint-fix",
      "detail": "Auto-fix ESLint issues",
      "type": "shell", 
      "command": "${input:packageManager}",
      "args": ["run", "lint", "--", "--fix"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$eslint-stylish"
      ]
    },
    {
      "label": "javascript:format-prettier",
      "detail": "Format code with Prettier",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["run", "format"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "javascript:format-check",
      "detail": "Check code formatting with Prettier",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["run", "format:check"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "javascript:test",
      "detail": "Run tests",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["test"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        "$jest-watch"
      ]
    },
    {
      "label": "javascript:test-coverage",
      "detail": "Run tests with coverage",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["run", "test:coverage"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        "$jest-watch"
      ]
    },
    {
      "label": "javascript:test-watch",
      "detail": "Run tests in watch mode",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["run", "test:watch"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        "$jest-watch"
      ]
    },
    {
      "label": "javascript:build",
      "detail": "Build project",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["run", "build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$typescript"
      ]
    },
    {
      "label": "javascript:build-watch",
      "detail": "Build project in watch mode",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["run", "build:watch"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        "$typescript"
      ]
    },
    {
      "label": "javascript:dev",
      "detail": "Start development server",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["run", "dev"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "javascript:type-check",
      "detail": "TypeScript type checking",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["run", "type-check"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$typescript"
      ]
    },
    {
      "label": "javascript:audit",
      "detail": "Audit dependencies for vulnerabilities",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["audit"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "javascript:audit-fix",
      "detail": "Auto-fix dependency vulnerabilities",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["audit", "fix"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "javascript:outdated",
      "detail": "Check for outdated dependencies",
      "type": "shell",
      "command": "${input:packageManager}",
      "args": ["outdated"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "javascript:clean",
      "detail": "Clean build artifacts and dependencies",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "rm -rf node_modules ${input:buildDirectory} && ${input:packageManager} install"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-Command",
          "Remove-Item -Recurse -Force node_modules, ${input:buildDirectory} -ErrorAction SilentlyContinue; ${input:packageManager} install"
        ]
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "javascript:quality-all",
      "detail": "Run all quality checks (lint, format-check, type-check, test)",
      "dependsOn": [
        "javascript:lint-eslint",
        "javascript:format-check",
        "javascript:type-check",
        "javascript:test-coverage",
        "javascript:audit"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    }
  ],
  "problemMatchers": [
    {
      "name": "$npm-install",
      "owner": "npm",
      "fileLocation": "absolute",
      "pattern": {
        "regexp": "^npm ERR! (.*)$",
        "message": 1
      }
    },
    {
      "name": "$jest-watch",
      "owner": "jest",
      "fileLocation": "relative",
      "pattern": [
        {
          "regexp": "^\\s+at\\s+(.*):(\\d+):(\\d+)$",
          "file": 1,
          "line": 2,
          "column": 3
        },
        {
          "regexp": "^\\s*(.*)\\s*\\((.*):(\\d+):(\\d+)\\)$",
          "message": 1,
          "file": 2,
          "line": 3,
          "column": 4
        }
      ]
    }
  ]
}
