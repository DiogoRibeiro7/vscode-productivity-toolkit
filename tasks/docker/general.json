{
  "taskVersion": "1.0.0",
  "category": "docker-general",
  "displayName": "Docker Container Management",
  "description": "Essential Docker container management tasks including building, running, debugging, and security scanning",
  "tasks": [
    {
      "label": "Docker: Build Image",
      "type": "shell",
      "command": "docker",
      "args": ["build", "-t", "${workspaceFolderBasename}:latest", "."],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Build Multi-stage Production",
      "type": "shell",
      "command": "docker",
      "args": ["build", "--target", "production", "-t", "${workspaceFolderBasename}:prod", "."],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Run Container",
      "type": "shell",
      "command": "docker",
      "args": ["run", "-p", "3000:3000", "${workspaceFolderBasename}:latest"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true
    },
    {
      "label": "Docker: Run Interactive Shell",
      "type": "shell",
      "command": "docker",
      "args": ["run", "-it", "--rm", "${workspaceFolderBasename}:latest", "/bin/bash"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Debug Container",
      "type": "shell",
      "command": "docker",
      "args": ["run", "-p", "3000:3000", "-p", "9229:9229", "${workspaceFolderBasename}:latest"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true
    },
    {
      "label": "Docker: List Images",
      "type": "shell",
      "command": "docker",
      "args": ["images", "--filter", "reference=${workspaceFolderBasename}*"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: List Running Containers",
      "type": "shell",
      "command": "docker",
      "args": ["ps"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Stop All Containers",
      "type": "shell",
      "command": "docker",
      "args": ["stop", "$(docker ps -q)"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Clean Unused Resources",
      "type": "shell",
      "command": "docker",
      "args": ["system", "prune", "-f"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Security Scan with Trivy",
      "type": "shell",
      "command": "trivy",
      "args": ["image", "${workspaceFolderBasename}:latest"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Vulnerability Scan with Snyk",
      "type": "shell",
      "command": "snyk",
      "args": ["container", "test", "${workspaceFolderBasename}:latest"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Check Image Layers",
      "type": "shell",
      "command": "docker",
      "args": ["history", "${workspaceFolderBasename}:latest"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Optimize Image Size",
      "type": "shell",
      "command": "docker",
      "args": ["run", "--rm", "-v", "/var/run/docker.sock:/var/run/docker.sock", "wagoodman/dive:latest", "${workspaceFolderBasename}:latest"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Tag for Registry",
      "type": "shell",
      "command": "docker",
      "args": ["tag", "${workspaceFolderBasename}:latest", "${input:registryUrl}/${workspaceFolderBasename}:${input:tagVersion}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Push to Registry",
      "type": "shell",
      "command": "docker",
      "args": ["push", "${input:registryUrl}/${workspaceFolderBasename}:${input:tagVersion}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
