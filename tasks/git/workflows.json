{
  "taskVersion": "1.0.0",
  "category": "git-workflows",
  "displayName": "Git Workflow Automation",
  "description": "Git workflow tasks including branch management, quality gates, and release automation",
  "tasks": [
    {
      "label": "Git: Create Feature Branch",
      "type": "shell",
      "command": "git",
      "args": ["checkout", "-b", "feature/${input:featureName}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Create Hotfix Branch",
      "type": "shell",
      "command": "git",
      "args": ["checkout", "-b", "hotfix/${input:hotfixName}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Switch to Main Branch",
      "type": "shell",
      "command": "git",
      "args": ["checkout", "main"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Update Main Branch",
      "type": "shell",
      "command": "sh",
      "args": ["-c", "git checkout main && git pull origin main"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Merge Feature to Main",
      "type": "shell",
      "command": "sh",
      "args": ["-c", "git checkout main && git merge feature/${input:featureName} --no-ff"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Interactive Rebase",
      "type": "shell",
      "command": "git",
      "args": ["rebase", "-i", "HEAD~${input:commitCount}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Squash Commits",
      "type": "shell",
      "command": "git",
      "args": ["reset", "--soft", "HEAD~${input:commitCount}", "&&", "git", "commit", "-m", "${input:commitMessage}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Check Repository Status",
      "type": "shell",
      "command": "git",
      "args": ["status", "--porcelain"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Show Branch History",
      "type": "shell",
      "command": "git",
      "args": ["log", "--oneline", "--graph", "--decorate", "-10"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Find Large Files",
      "type": "shell",
      "command": "git",
      "args": ["rev-list", "--objects", "--all", "|", "git", "cat-file", "--batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)'", "|", "sed", "-n", "s/^blob //p", "|", "sort", "--numeric-sort", "--key=2", "|", "tail", "-10"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Clean Merged Branches",
      "type": "shell",
      "command": "git",
      "args": ["branch", "--merged", "main", "|", "grep", "-v", "main", "|", "xargs", "-n", "1", "git", "branch", "-d"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Validate Commit Messages",
      "type": "shell",
      "command": "commitizen",
      "args": ["check", "--commit-msg-file", ".git/COMMIT_EDITMSG"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Generate Changelog",
      "type": "shell",
      "command": "conventional-changelog",
      "args": ["-p", "angular", "-i", "CHANGELOG.md", "-s"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Create Release Tag",
      "type": "shell",
      "command": "git",
      "args": ["tag", "-a", "v${input:version}", "-m", "Release version ${input:version}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git: Push Tags",
      "type": "shell",
      "command": "git",
      "args": ["push", "origin", "--tags"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
