{
  "taskVersion": "1.0.0",
  "category": "docker-compose",
  "displayName": "Docker Compose Orchestration",
  "description": "Docker Compose tasks for multi-service application management, including development and production environments",
  "tasks": [
    {
      "label": "Compose: Start All Services",
      "type": "shell",
      "command": "docker-compose",
      "args": ["up", "-d"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Compose: Start Development Environment",
      "type": "shell",
      "command": "docker-compose",
      "args": ["-f", "docker-compose.yml", "-f", "docker-compose.dev.yml", "up", "-d"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Compose: Start Production Environment",
      "type": "shell",
      "command": "docker-compose",
      "args": ["-f", "docker-compose.yml", "-f", "docker-compose.prod.yml", "up", "-d"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Compose: Build and Start",
      "type": "shell",
      "command": "docker-compose",
      "args": ["up", "--build", "-d"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Compose: Stop All Services",
      "type": "shell",
      "command": "docker-compose",
      "args": ["down"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Compose: Stop and Remove Volumes",
      "type": "shell",
      "command": "docker-compose",
      "args": ["down", "-v"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Compose: View Service Logs",
      "type": "shell",
      "command": "docker-compose",
      "args": ["logs", "-f"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true
    },
    {
      "label": "Compose: View Specific Service Logs",
      "type": "shell",
      "command": "docker-compose",
      "args": ["logs", "-f", "${input:serviceName}"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true
    },
    {
      "label": "Compose: Check Service Status",
      "type": "shell",
      "command": "docker-compose",
      "args": ["ps"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Compose: Execute Shell in Service",
      "type": "shell",
      "command": "docker-compose",
      "args": ["exec", "${input:serviceName}", "/bin/bash"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Compose: Restart Service",
      "type": "shell",
      "command": "docker-compose",
      "args": ["restart", "${input:serviceName}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Compose: Scale Service",
      "type": "shell",
      "command": "docker-compose",
      "args": ["up", "-d", "--scale", "${input:serviceName}=${input:replicaCount}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Compose: Validate Configuration",
      "type": "shell",
      "command": "docker-compose",
      "args": ["config"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Compose: Health Check",
      "type": "shell",
      "command": "docker-compose",
      "args": ["exec", "-T", "${input:serviceName}", "curl", "-f", "http://localhost:${input:healthPort}/health"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Compose: Database Backup",
      "type": "shell",
      "command": "docker-compose",
      "args": ["exec", "-T", "db", "pg_dump", "-U", "${input:dbUser}", "${input:dbName}", ">", "backup_$(date +%Y%m%d_%H%M%S).sql"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
