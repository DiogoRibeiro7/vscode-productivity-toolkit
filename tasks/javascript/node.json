{
  "taskVersion": "1.0.0",
  "category": "node-server",
  "displayName": "Node.js Server Development",
  "description": "Node.js server development tasks including Express/Fastify, database management, and deployment automation",
  "tasks": [
    {
      "label": "Node: Start Development Server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true
    },
    {
      "label": "Node: Start Production Server",
      "type": "shell",
      "command": "npm",
      "args": ["start"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true
    },
    {
      "label": "Node: Debug Server",
      "type": "shell",
      "command": "node",
      "args": ["--inspect", "server.js"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true
    },
    {
      "label": "Database: Run Migrations",
      "type": "shell",
      "command": "npx",
      "args": ["knex", "migrate:latest"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Database: Rollback Migration",
      "type": "shell",
      "command": "npx",
      "args": ["knex", "migrate:rollback"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Database: Seed Data",
      "type": "shell",
      "command": "npx",
      "args": ["knex", "seed:run"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "API: Generate Documentation",
      "type": "shell",
      "command": "npx",
      "args": ["swagger-jsdoc", "-d", "swaggerDef.js", "-o", "swagger.json", "routes/*.js"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "API: Test Endpoints",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test:api"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Health: Check Server Status",
      "type": "shell",
      "command": "curl",
      "args": ["-f", "http://localhost:3000/health"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "PM2: Start Application",
      "type": "shell",
      "command": "npx",
      "args": ["pm2", "start", "ecosystem.config.js"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "PM2: Monitor Application",
      "type": "shell",
      "command": "npx",
      "args": ["pm2", "monit"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true
    },
    {
      "label": "PM2: Restart Application",
      "type": "shell",
      "command": "npx",
      "args": ["pm2", "restart", "all"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
