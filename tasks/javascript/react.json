{
  "taskVersion": "1.0.0",
  "category": "react-development",
  "displayName": "React Application Development",
  "description": "React development tasks including component scaffolding, testing, Storybook, and performance optimization",
  "tasks": [
    {
      "label": "React: Start Development Server",
      "type": "shell",
      "command": "npm",
      "args": ["start"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true
    },
    {
      "label": "React: Build for Production",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "React: Analyze Bundle Size",
      "type": "shell",
      "command": "npx",
      "args": ["webpack-bundle-analyzer", "build/static/js/*.js"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "React: Generate Component",
      "type": "shell",
      "command": "npx",
      "args": ["generate-react-cli", "component"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Storybook: Start Server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "storybook"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "isBackground": true
    },
    {
      "label": "Storybook: Build Static",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build-storybook"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Test: Component Tests",
      "type": "shell",
      "command": "npm",
      "args": ["test", "--", "--watchAll=false"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Test: E2E with Cypress",
      "type": "shell",
      "command": "npx",
      "args": ["cypress", "run"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Test: Visual Regression",
      "type": "shell",
      "command": "npx",
      "args": ["chromatic", "--project-token=${CHROMATIC_PROJECT_TOKEN}"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Accessibility: Run axe Tests",
      "type": "shell",
      "command": "npx",
      "args": ["@axe-core/cli", "http://localhost:3000"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Performance: Lighthouse Audit",
      "type": "shell",
      "command": "npx",
      "args": ["lighthouse", "http://localhost:3000", "--output=html", "--output-path=./lighthouse-report.html"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "PWA: Generate Service Worker",
      "type": "shell",
      "command": "npx",
      "args": ["workbox", "generateSW", "workbox-config.js"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "PWA: Validate Manifest",
      "type": "shell",
      "command": "npx",
      "args": ["web-app-manifest-validator", "public/manifest.json"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Deployment: Deploy to Netlify",
      "type": "shell",
      "command": "npx",
      "args": ["netlify", "deploy", "--prod", "--dir=build"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
