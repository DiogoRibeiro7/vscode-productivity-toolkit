{
  "_fileLocation": "/tasks/python/",
  "_metadata": {
    "license": "MIT License - Copyright (c) 2025 Diogo Ribeiro",
    "maintainer": "Diogo Ribeiro <dfr@esmad.ipp.pt>",
    "description": "VS Code tasks for Python data science workflows: Jupyter notebooks, profiling, documentation, and environment management.",
    "version": "1.0.0"
  },
  "version": "2.0.0",
  "inputs": [
    {
      "id": "pythonInterpreter",
      "type": "promptString",
      "description": "Python interpreter path",
      "default": "python"
    },
    {
      "id": "notebookDirectory",
      "type": "promptString",
      "description": "Jupyter notebook directory",
      "default": "notebooks"
    },
    {
      "id": "dataDirectory",
      "type": "promptString",
      "description": "Data directory path",
      "default": "data"
    },
    {
      "id": "outputDirectory",
      "type": "promptString",
      "description": "Output directory for generated files",
      "default": "output"
    },
    {
      "id": "docsDirectory",
      "type": "promptString",
      "description": "Documentation directory",
      "default": "docs"
    }
  ],
  "tasks": [
    {
      "label": "data-science:start-jupyter",
      "detail": "Start Jupyter Lab server",
      "type": "shell",
      "command": "${input:pythonInterpreter}",
      "args": ["-m", "jupyter", "lab", "--no-browser"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:convert-notebooks-html",
      "detail": "Convert Jupyter notebooks to HTML",
      "type": "shell",
      "command": "${input:pythonInterpreter}",
      "args": [
        "-m", "jupyter", "nbconvert",
        "--to", "html",
        "${input:notebookDirectory}/*.ipynb",
        "--output-dir", "${input:outputDirectory}/html"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:convert-notebooks-pdf",
      "detail": "Convert Jupyter notebooks to PDF",
      "type": "shell",
      "command": "${input:pythonInterpreter}",
      "args": [
        "-m", "jupyter", "nbconvert",
        "--to", "pdf",
        "${input:notebookDirectory}/*.ipynb",
        "--output-dir", "${input:outputDirectory}/pdf"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:clean-notebooks",
      "detail": "Clean notebook outputs and metadata",
      "type": "shell",
      "command": "${input:pythonInterpreter}",
      "args": [
        "-m", "jupyter", "nbconvert",
        "--ClearOutputPreprocessor.enabled=True",
        "--ClearMetadataPreprocessor.enabled=True",
        "--to", "notebook",
        "--inplace",
        "${input:notebookDirectory}/*.ipynb"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:profile-memory",
      "detail": "Profile memory usage with memory-profiler",
      "type": "shell",
      "command": "${input:pythonInterpreter}",
      "args": ["-m", "memory_profiler", "${file}"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:profile-line",
      "detail": "Line-by-line profiling with line_profiler",
      "type": "shell",
      "command": "${input:pythonInterpreter}",
      "args": ["-m", "kernprof", "-l", "-v", "${file}"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:generate-report",
      "detail": "Generate pandas profiling report",
      "type": "shell",
      "command": "${input:pythonInterpreter}",
      "args": [
        "-c", 
        "import pandas as pd; from ydata_profiling import ProfileReport; df = pd.read_csv('${input:dataDirectory}/data.csv'); profile = ProfileReport(df, title='Data Profile Report'); profile.to_file('${input:outputDirectory}/profile_report.html')"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:validate-data",
      "detail": "Validate data with Great Expectations",
      "type": "shell",
      "command": "${input:pythonInterpreter}",
      "args": ["-m", "great_expectations", "checkpoint", "run"],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:docs-sphinx-build",
      "detail": "Build Sphinx documentation",
      "type": "shell",
      "command": "${input:pythonInterpreter}",
      "args": ["-m", "sphinx", "-b", "html", "${input:docsDirectory}", "${input:outputDirectory}/docs"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$sphinx"
      ]
    },
    {
      "label": "data-science:docs-auto-generate",
      "detail": "Auto-generate API documentation with sphinx-apidoc",
      "type": "shell",
      "command": "${input:pythonInterpreter}",
      "args": [
        "-m", "sphinx.apidoc",
        "-o", "${input:docsDirectory}/api",
        "-f", "-e",
        "."
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:environment-export",
      "detail": "Export conda environment to file",
      "type": "shell",
      "command": "conda",
      "args": ["env", "export", "--no-builds", ">", "environment.yml"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:environment-update",
      "detail": "Update conda environment from file",
      "type": "shell",
      "command": "conda",
      "args": ["env", "update", "--file", "environment.yml", "--prune"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:requirements-generate",
      "detail": "Generate requirements.txt from environment",
      "type": "shell",
      "command": "${input:pythonInterpreter}",
      "args": ["-m", "pip", "freeze", ">", "requirements.txt"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:data-backup",
      "detail": "Create compressed backup of data directory",
      "type": "shell",
      "command": "tar",
      "args": [
        "-czf", 
        "${input:outputDirectory}/data_backup_$(date +%Y%m%d_%H%M%S).tar.gz",
        "${input:dataDirectory}"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-Command",
          "Compress-Archive -Path '${input:dataDirectory}' -DestinationPath '${input:outputDirectory}/data_backup_$(Get-Date -Format 'yyyyMMdd_HHmmss').zip'"
        ]
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "data-science:workflow-complete",
      "detail": "Complete data science workflow: clean notebooks, generate docs, create report",
      "dependsOn": [
        "data-science:clean-notebooks",
        "data-science:docs-auto-generate",
        "data-science:docs-sphinx-build",
        "data-science:generate-report"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    }
  ],
  "problemMatchers": [
    {
      "name": "$sphinx",
      "owner": "sphinx",
      "fileLocation": "absolute",
      "pattern": {
        "regexp": "^(.*):(\\d+):\\s+(WARNING|ERROR):\\s+(.*)$",
        "file": 1,
        "line": 2,
        "severity": 3,
        "message": 4
      }
    }
  ]
}
