{
  "taskVersion": "1.0.0",
  "category": "git-hooks",
  "displayName": "Git Hooks Management",
  "description": "Git hooks automation for quality gates, pre-commit validation, and automated testing",
  "tasks": [
    {
      "label": "Git Hooks: Install Pre-commit",
      "type": "shell",
      "command": "pre-commit",
      "args": ["install"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Run All Pre-commit Hooks",
      "type": "shell",
      "command": "pre-commit",
      "args": ["run", "--all-files"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Update Hook Versions",
      "type": "shell",
      "command": "pre-commit",
      "args": ["autoupdate"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Validate Staged Files",
      "type": "shell",
      "command": "pre-commit",
      "args": ["run"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Lint Commit Message",
      "type": "shell",
      "command": "commitlint",
      "args": ["--edit", ".git/COMMIT_EDITMSG"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Run Tests Before Push",
      "type": "shell",
      "command": "npm",
      "args": ["test", "--", "--watchAll=false", "--coverage"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Security Scan Before Commit",
      "type": "shell",
      "command": "git-secrets",
      "args": ["--scan"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Install Git Secrets",
      "type": "shell",
      "command": "git-secrets",
      "args": ["--install"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Add AWS Secrets Patterns",
      "type": "shell",
      "command": "git-secrets",
      "args": ["--register-aws"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Custom Pattern Check",
      "type": "shell",
      "command": "git-secrets",
      "args": ["--add", "${input:secretPattern}"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Install Husky",
      "type": "shell",
      "command": "npx",
      "args": ["husky", "install"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Add Pre-commit Hook",
      "type": "shell",
      "command": "npx",
      "args": ["husky", "add", ".husky/pre-commit", "npm test"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Add Commit Message Hook",
      "type": "shell",
      "command": "npx",
      "args": ["husky", "add", ".husky/commit-msg", "npx commitlint --edit $1"],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Git Hooks: Test Hook Configuration",
      "type": "shell",
      "command": "sh",
      "args": ["-c", "echo 'test commit' | .husky/commit-msg"],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
